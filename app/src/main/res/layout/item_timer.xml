<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="false"
            app:strokeColor="@color/timer_stroke"
            app:strokeWidth="1dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/timer_15"
                android:textColor="@color/timer_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                app:backgroundTint="@color/timer_bg_selector"
                app:strokeColor="@color/timer_stroke"
                app:strokeWidth="1dp"
                app:iconTint="@color/timer_text"
                app:iconSize="16dp"
                android:layout_weight="1"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn30"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/timer_30"
                android:textColor="@color/timer_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:layout_weight="1"
                app:backgroundTint="@color/timer_bg_selector"
                app:strokeColor="@color/timer_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn45"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/timer_45"
                android:textColor="@color/timer_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:layout_weight="1"
                app:backgroundTint="@color/timer_bg_selector"
                app:strokeColor="@color/timer_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn60"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/timer_60"
                android:textColor="@color/timer_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:layout_weight="1"
                app:backgroundTint="@color/timer_bg_selector"
                app:strokeColor="@color/timer_stroke"
                app:strokeWidth="1dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
</layout>
